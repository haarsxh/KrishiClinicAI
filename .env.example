# ─── AI Provider Configuration ──────────────────────
# Options: "mock" (no API key needed), "gemini", "groq", or "openai"
AI_PROVIDER=mock

# Required only when AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Required only when AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Required only when AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ─── Database ───────────────────────────────────────
# These match the docker-compose.yml defaults
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=krishiclinic

# Docker Compose uses the "db" hostname and needs no change:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/krishiclinic
#
# Running locally WITHOUT Docker? Use one of these instead:
#   SQLite (no server to install):
#     DATABASE_URL=sqlite+aiosqlite:///./krishiclinic.db
#   Local PostgreSQL (note "localhost", not "db"):
#     DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/krishiclinic

# ─── Security ─────────────────────────────────────────
# REQUIRED — the API refuses to start without it.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your_jwt_secret_here_replace_with_secure_random_string

# ─── Review Workflow ────────────────────────────────
# true  = every AI diagnosis waits for an agronomist to approve it before the
#         farmer can see it (recommended - no unverified advice reaches farmers).
# false = diagnoses at or above AUTO_APPROVE_CONFIDENCE_THRESHOLD are released
#         to the farmer automatically, without human review.
REQUIRE_AGRONOMIST_APPROVAL=true
AUTO_APPROVE_CONFIDENCE_THRESHOLD=0.7

# ─── Frontend ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

